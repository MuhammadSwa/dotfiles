/**
 * ╔══════════════════════════════════════════════════════════════════════════╗
 * ║                         Gruvbox Theme                                     ║
 * ║              Retro groove color scheme for rofi                          ║
 * ╚══════════════════════════════════════════════════════════════════════════╝
 *
 * Based on morhetz/gruvbox color scheme
 */

* {
    /* Gruvbox Colors - Dark */
    bg0-hard:        #1d2021;
    bg0:             #282828;
    bg0-soft:        #32302f;
    bg1:             #3c3836;
    bg2:             #504945;
    bg3:             #665c54;
    bg4:             #7c6f64;
    
    fg0:             #fbf1c7;
    fg1:             #ebdbb2;
    fg2:             #d5c4a1;
    fg3:             #bdae93;
    fg4:             #a89984;
    
    red:             #fb4934;
    red-dim:         #cc241d;
    green:           #b8bb26;
    green-dim:       #98971a;
    yellow:          #fabd2f;
    yellow-dim:      #d79921;
    blue:            #83a598;
    blue-dim:        #458588;
    purple:          #d3869b;
    purple-dim:      #b16286;
    aqua:            #8ec07c;
    aqua-dim:        #689d6a;
    orange:          #fe8019;
    orange-dim:      #d65d0e;
    
    /* Theme Variables */
    background:      @bg0;
    background-alt:  @bg1;
    foreground:      @fg1;
    selected:        @yellow;
    active:          @green;
    urgent:          @red;
    
    background-color: transparent;
    text-color:       @foreground;
    
    margin:           0;
    padding:          0;
    spacing:          0;
}

/*---------- Main Window ----------*/
window {
    location:         center;
    anchor:           center;
    fullscreen:       false;
    width:            620px;
    x-offset:         0px;
    y-offset:         0px;
    
    enabled:          true;
    border-radius:    8px;
    border:           4px solid;
    border-color:     @orange;
    cursor:           "default";
    background-color: @background;
}

/*---------- Main Container ----------*/
mainbox {
    enabled:          true;
    spacing:          0px;
    background-color: transparent;
    orientation:      vertical;
    children:         [ "inputbar", "listview" ];
}

/*---------- Inputbar ----------*/
inputbar {
    enabled:          true;
    spacing:          0px;
    padding:          0px;
    background-color: @bg1;
    text-color:       @foreground;
    orientation:      horizontal;
    children:         [ "textbox-prompt-colon", "entry", "case-indicator" ];
}

textbox-prompt-colon {
    enabled:          true;
    expand:           false;
    str:              " ";
    padding:          16px 14px;
    background-color: @orange;
    text-color:       @bg0;
    font:             "JetBrainsMono Nerd Font 16";
}

entry {
    enabled:          true;
    expand:           true;
    padding:          16px;
    background-color: inherit;
    text-color:       @foreground;
    cursor:           text;
    placeholder:      "Search...";
    placeholder-color: @bg4;
}

case-indicator {
    enabled:          true;
    padding:          16px;
    background-color: inherit;
    text-color:       @yellow;
}

/*---------- Listview ----------*/
listview {
    enabled:          true;
    columns:          2;
    lines:            5;
    cycle:            true;
    dynamic:          true;
    scrollbar:        false;
    layout:           vertical;
    reverse:          false;
    fixed-height:     true;
    fixed-columns:    true;
    
    spacing:          5px;
    padding:          10px;
    background-color: transparent;
    text-color:       @foreground;
    cursor:           "default";
}

/*---------- Elements ----------*/
element {
    enabled:          true;
    spacing:          10px;
    padding:          12px;
    border-radius:    6px;
    background-color: @bg1;
    text-color:       @foreground;
    cursor:           pointer;
}

element normal.normal {
    background-color: inherit;
    text-color:       inherit;
}

element normal.urgent {
    background-color: @urgent;
    text-color:       @bg0;
}

element normal.active {
    background-color: @active;
    text-color:       @bg0;
}

element selected.normal {
    background-color: @yellow;
    text-color:       @bg0;
}

element selected.urgent {
    background-color: @red;
    text-color:       @bg0;
}

element selected.active {
    background-color: @green;
    text-color:       @bg0;
}

element alternate.normal {
    background-color: @bg0-soft;
    text-color:       @foreground;
}

element-icon {
    background-color: transparent;
    text-color:       inherit;
    size:             28px;
    cursor:           inherit;
}

element-text {
    background-color: transparent;
    text-color:       inherit;
    cursor:           inherit;
    vertical-align:   0.5;
    horizontal-align: 0.0;
}

/*---------- Message ----------*/
message {
    background-color: transparent;
    padding:          10px;
}

textbox {
    padding:          12px;
    border-radius:    6px;
    background-color: @bg1;
    text-color:       @yellow;
    vertical-align:   0.5;
    horizontal-align: 0.0;
}

error-message {
    padding:          12px;
    border-radius:    8px;
    background-color: @background;
    text-color:       @red;
}
