/**
 * ╔══════════════════════════════════════════════════════════════════════════╗
 * ║                         Glass/Blur Theme                                  ║
 * ║              Modern glassmorphism design with transparency               ║
 * ╚══════════════════════════════════════════════════════════════════════════╝
 *
 * Note: This theme works best with a compositor that supports blur
 * (picom, hyprland, etc.)
 */

* {
    /* Glass Colors - Semi-transparent */
    transparent:     rgba(0, 0, 0, 0);
    glass-bg:        rgba(20, 20, 30, 0.75);
    glass-surface:   rgba(40, 40, 60, 0.6);
    glass-hover:     rgba(60, 60, 90, 0.7);
    glass-border:    rgba(255, 255, 255, 0.1);
    white:           #ffffff;
    white-dim:       rgba(255, 255, 255, 0.7);
    white-muted:     rgba(255, 255, 255, 0.4);
    accent:          #7c3aed;
    accent-glow:     rgba(124, 58, 237, 0.5);
    green:           #10b981;
    red:             #ef4444;
    
    /* Theme Variables */
    background:      @glass-bg;
    background-alt:  @glass-surface;
    foreground:      @white;
    selected:        @accent;
    active:          @green;
    urgent:          @red;
    
    background-color: transparent;
    text-color:       @foreground;
    
    margin:           0;
    padding:          0;
    spacing:          0;
}

/*---------- Main Window ----------*/
window {
    location:         center;
    anchor:           center;
    fullscreen:       false;
    width:            600px;
    x-offset:         0px;
    y-offset:         0px;
    
    enabled:          true;
    border-radius:    24px;
    border:           1px solid;
    border-color:     @glass-border;
    cursor:           "default";
    background-color: @background;
    transparency:     "real";
}

/*---------- Main Container ----------*/
mainbox {
    enabled:          true;
    spacing:          20px;
    padding:          25px;
    background-color: transparent;
    orientation:      vertical;
    children:         [ "inputbar", "listview" ];
}

/*---------- Inputbar ----------*/
inputbar {
    enabled:          true;
    spacing:          15px;
    padding:          0px;
    background-color: transparent;
    text-color:       @foreground;
    orientation:      horizontal;
    children:         [ "textbox-prompt-colon", "entry" ];
}

textbox-prompt-colon {
    enabled:          true;
    expand:           false;
    str:              "󰍉";
    padding:          16px 18px;
    border-radius:    16px;
    background-color: @accent;
    text-color:       @white;
    font:             "JetBrainsMono Nerd Font 16";
}

entry {
    enabled:          true;
    expand:           true;
    padding:          16px 20px;
    border-radius:    16px;
    border:           1px solid;
    border-color:     @glass-border;
    background-color: @glass-surface;
    text-color:       @foreground;
    cursor:           text;
    placeholder:      "Search...";
    placeholder-color: @white-muted;
}

/*---------- Listview ----------*/
listview {
    enabled:          true;
    columns:          1;
    lines:            6;
    cycle:            true;
    dynamic:          true;
    scrollbar:        false;
    layout:           vertical;
    reverse:          false;
    fixed-height:     true;
    fixed-columns:    true;
    
    spacing:          8px;
    padding:          0px;
    background-color: transparent;
    text-color:       @foreground;
    cursor:           "default";
}

/*---------- Elements ----------*/
element {
    enabled:          true;
    spacing:          15px;
    padding:          14px 18px;
    border-radius:    14px;
    background-color: transparent;
    text-color:       @white-dim;
    cursor:           pointer;
}

element normal.normal {
    background-color: inherit;
    text-color:       inherit;
}

element normal.urgent {
    background-color: inherit;
    text-color:       @urgent;
}

element normal.active {
    background-color: inherit;
    text-color:       @active;
}

element selected.normal {
    background-color: @glass-hover;
    text-color:       @white;
    border:           1px solid;
    border-color:     @accent-glow;
}

element selected.urgent {
    background-color: @glass-hover;
    text-color:       @urgent;
}

element selected.active {
    background-color: @glass-hover;
    text-color:       @active;
}

element-icon {
    background-color: transparent;
    text-color:       inherit;
    size:             28px;
    cursor:           inherit;
}

element-text {
    background-color: transparent;
    text-color:       inherit;
    cursor:           inherit;
    vertical-align:   0.5;
    horizontal-align: 0.0;
}

/*---------- Message ----------*/
message {
    background-color: transparent;
    padding:          0px;
}

textbox {
    padding:          14px 18px;
    border-radius:    14px;
    background-color: @glass-surface;
    text-color:       @white-dim;
    vertical-align:   0.5;
    horizontal-align: 0.0;
}

error-message {
    padding:          20px;
    border-radius:    24px;
    background-color: @background;
    text-color:       @red;
}
