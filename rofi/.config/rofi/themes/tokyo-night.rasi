/**
 * ╔══════════════════════════════════════════════════════════════════════════╗
 * ║                        Tokyo Night Theme                                  ║
 * ║             A clean, dark theme inspired by Tokyo's nightlife            ║
 * ╚══════════════════════════════════════════════════════════════════════════╝
 *
 * Based on the popular Tokyo Night VS Code theme
 */

* {
    /* Tokyo Night Colors */
    bg:              #1a1b26;
    bg-dark:         #16161e;
    bg-highlight:    #292e42;
    terminal-black:  #414868;
    fg:              #c0caf5;
    fg-dark:         #a9b1d6;
    fg-gutter:       #3b4261;
    dark3:           #545c7e;
    comment:         #565f89;
    dark5:           #737aa2;
    blue0:           #3d59a1;
    blue:            #7aa2f7;
    cyan:            #7dcfff;
    blue1:           #2ac3de;
    blue2:           #0db9d7;
    blue5:           #89ddff;
    blue6:           #b4f9f8;
    blue7:           #394b70;
    magenta:         #bb9af7;
    magenta2:        #ff007c;
    purple:          #9d7cd8;
    orange:          #ff9e64;
    yellow:          #e0af68;
    green:           #9ece6a;
    green1:          #73daca;
    green2:          #41a6b5;
    teal:            #1abc9c;
    red:             #f7768e;
    red1:            #db4b4b;
    
    /* Theme Variables */
    background:      @bg;
    background-alt:  @bg-highlight;
    foreground:      @fg;
    selected:        @blue;
    active:          @green;
    urgent:          @red;
    
    background-color: transparent;
    text-color:       @foreground;
    
    margin:           0;
    padding:          0;
    spacing:          0;
}

/*---------- Main Window ----------*/
window {
    location:         center;
    anchor:           center;
    fullscreen:       false;
    width:            580px;
    x-offset:         0px;
    y-offset:         0px;
    
    enabled:          true;
    border-radius:    16px;
    border:           2px solid;
    border-color:     @blue;
    cursor:           "default";
    background-color: @background;
}

/*---------- Main Container ----------*/
mainbox {
    enabled:          true;
    spacing:          15px;
    padding:          15px;
    background-color: transparent;
    orientation:      vertical;
    children:         [ "inputbar", "listview", "mode-switcher" ];
}

/*---------- Inputbar ----------*/
inputbar {
    enabled:          true;
    spacing:          10px;
    padding:          0px;
    background-color: transparent;
    text-color:       @foreground;
    orientation:      horizontal;
    children:         [ "textbox-prompt-colon", "entry" ];
}

textbox-prompt-colon {
    enabled:          true;
    expand:           false;
    str:              "";
    padding:          14px 16px;
    border-radius:    12px;
    background-color: @blue;
    text-color:       @bg;
    font:             "JetBrainsMono Nerd Font 14";
}

entry {
    enabled:          true;
    expand:           true;
    padding:          14px;
    border-radius:    12px;
    background-color: @background-alt;
    text-color:       @foreground;
    cursor:           text;
    placeholder:      "Search applications...";
    placeholder-color: @comment;
}

/*---------- Listview ----------*/
listview {
    enabled:          true;
    columns:          1;
    lines:            7;
    cycle:            true;
    dynamic:          true;
    scrollbar:        false;
    layout:           vertical;
    reverse:          false;
    fixed-height:     true;
    fixed-columns:    true;
    
    spacing:          5px;
    padding:          0px;
    background-color: transparent;
    text-color:       @foreground;
    cursor:           "default";
}

/*---------- Elements ----------*/
element {
    enabled:          true;
    spacing:          12px;
    padding:          10px 15px;
    border-radius:    12px;
    background-color: transparent;
    text-color:       @foreground;
    cursor:           pointer;
}

element normal.normal {
    background-color: inherit;
    text-color:       inherit;
}

element normal.urgent {
    background-color: @urgent;
    text-color:       @bg;
}

element normal.active {
    background-color: @active;
    text-color:       @bg;
}

element selected.normal {
    background-color: @background-alt;
    text-color:       @blue;
    border:           0px 0px 0px 3px solid;
    border-color:     @blue;
}

element selected.urgent {
    background-color: @urgent;
    text-color:       @bg;
}

element selected.active {
    background-color: @active;
    text-color:       @bg;
}

element-icon {
    background-color: transparent;
    text-color:       inherit;
    size:             28px;
    cursor:           inherit;
}

element-text {
    background-color: transparent;
    text-color:       inherit;
    cursor:           inherit;
    vertical-align:   0.5;
    horizontal-align: 0.0;
}

/*---------- Mode Switcher ----------*/
mode-switcher {
    enabled:          true;
    spacing:          10px;
    padding:          0px;
    background-color: transparent;
    text-color:       @foreground;
}

button {
    padding:          10px 20px;
    border-radius:    12px;
    background-color: @background-alt;
    text-color:       @foreground;
    cursor:           pointer;
}

button selected {
    background-color: @blue;
    text-color:       @bg;
}

/*---------- Message ----------*/
message {
    background-color: transparent;
    padding:          0px;
}

textbox {
    padding:          14px;
    border-radius:    12px;
    background-color: @background-alt;
    text-color:       @cyan;
    vertical-align:   0.5;
    horizontal-align: 0.0;
}

error-message {
    padding:          15px;
    border-radius:    16px;
    background-color: @background;
    text-color:       @red;
}
