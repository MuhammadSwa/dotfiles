/**
 * ╔══════════════════════════════════════════════════════════════════════════╗
 * ║                         Launcher Theme                                    ║
 * ║                  Centered, fullscreen-ish launcher                       ║
 * ╚══════════════════════════════════════════════════════════════════════════╝
 */

@import "catppuccin-mocha.rasi"

window {
    fullscreen:       false;
    width:            100%;
    height:           100%;
    border-radius:    0px;
    border:           0px;
    background-color: rgba(30, 30, 46, 0.85);
}

mainbox {
    children:         [ "dummy", "inputbar", "listview", "dummy" ];
    padding:          0px;
    spacing:          0px;
}

dummy {
    expand:           true;
    background-color: transparent;
}

inputbar {
    padding:          20px 30%;
    background-color: transparent;
    background-image: none;
}

textbox-prompt-colon {
    padding:          18px 20px;
    font:             "JetBrainsMono Nerd Font 18";
}

entry {
    padding:          18px 22px;
    font:             "JetBrainsMono Nerd Font 14";
}

listview {
    columns:          4;
    lines:            3;
    spacing:          25px;
    padding:          30px 15%;
    fixed-height:     false;
}

element {
    padding:          25px 20px;
    border-radius:    16px;
    orientation:      vertical;
}

element-icon {
    size:             64px;
    horizontal-align: 0.5;
    margin:           0px 0px 10px 0px;
}

element-text {
    horizontal-align: 0.5;
    vertical-align:   0.5;
}
