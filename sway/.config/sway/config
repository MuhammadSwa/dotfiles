# ╔═══════════════════════════════════════════════════════════════════════════╗
# ║                           SWAY CONFIGURATION                              ║
# ║                        Modern & Clean Setup                               ║
# ╚═══════════════════════════════════════════════════════════════════════════╝

# ┌───────────────────────────────────────────────────────────────────────────┐
# │                              VARIABLES                                    │
# └───────────────────────────────────────────────────────────────────────────┘

# Modifier key (Mod4 = Super/Windows, Mod1 = Alt)
set $mod Mod4

# Vim-style direction keys
set $left  h
set $down  j
set $up    k
set $right l

# Applications
set $term        ghostty
set $browser     brave --enable-features=UseOzonePlatform --ozone-platform=wayland
set $fileManager thunar
# set $menu        rofi -show drun -show-icons -theme ~/.config/rofi/config.rasi
set $menu        ~/Mzahrawi/productivity/badi/zig-out/bin/Badi
set $lock        swaylock -f -e -l -L -s fill -i ~/dotfiles/Data/Data/Arabic-Background-HD.webp

# Colors (Catppuccin Mocha inspired)
set $rosewater #f5e0dc
set $flamingo  #f2cdcd
set $pink      #f5c2e7
set $mauve     #cba6f7
set $red       #f38ba8
set $maroon    #eba0ac
set $peach     #fab387
set $yellow    #f9e2af
set $green     #a6e3a1
set $teal      #94e2d5
set $sky       #89dceb
set $sapphire  #74c7ec
set $blue      #89b4fa
set $lavender  #b4befe
set $text      #cdd6f4
set $subtext1  #bac2de
set $subtext0  #a6adc8
set $overlay2  #9399b2
set $overlay1  #7f849c
set $overlay0  #6c7086
set $surface2  #585b70
set $surface1  #45475a
set $surface0  #313244
set $base      #1e1e2e
set $mantle    #181825
set $crust     #11111b

# ┌───────────────────────────────────────────────────────────────────────────┐
# │                              APPEARANCE                                   │
# └───────────────────────────────────────────────────────────────────────────┘

# Window borders and gaps
default_border pixel 2
default_floating_border pixel 2
smart_borders on
smart_gaps on
gaps inner 8
gaps outer 4

# Title bar font (larger for better tab visibility)
font pango:JetBrainsMono Nerd Font Bold 12

# Window colors         border     background  text       indicator  child_border
client.focused          $mauve     $mauve      $crust     $mauve     $mauve
client.focused_inactive $surface1  $base       $subtext1  $surface1  $surface1
client.unfocused        $surface0  $base       $overlay0  $surface0  $surface0
client.urgent           $red       $base       $red       $red       $red
client.placeholder      $base      $base       $text      $base      $base
client.background       $base

# Title bar configuration for tabs
titlebar_border_thickness 2
titlebar_padding 8 4

# Cursor theme
seat seat0 xcursor_theme Adwaita 24

# ┌───────────────────────────────────────────────────────────────────────────┐
# │                              OUTPUT                                       │
# └───────────────────────────────────────────────────────────────────────────┘

# Wallpaper
output * bg ~/dotfiles/Data/Data/Arabic-Background-HD.webp fill

# Enable adaptive sync (FreeSync/G-Sync)
output * adaptive_sync on

# ┌───────────────────────────────────────────────────────────────────────────┐
# │                              INPUT                                        │
# └───────────────────────────────────────────────────────────────────────────┘

input type:keyboard {
    xkb_layout us,ara
    xkb_options grp:alt_shift_toggle,caps:escape
    repeat_delay 300
    repeat_rate 25
}

input type:touchpad {
    tap enabled
    natural_scroll enabled
    dwt enabled
    accel_profile adaptive
    pointer_accel 0.3
}

input type:pointer {
    accel_profile flat
    pointer_accel 0
}

# ┌───────────────────────────────────────────────────────────────────────────┐
# │                           AUTOSTART                                       │
# └───────────────────────────────────────────────────────────────────────────┘

# Authentication & system services
exec --no-startup-id /usr/lib/pam_kwallet_init
exec --no-startup-id /usr/lib/polkit-gnome/polkit-gnome-authentication-agent-1

# Network & Bluetooth applets
exec --no-startup-id nm-applet --indicator
exec --no-startup-id blueman-applet

# Notification daemon
exec --no-startup-id mako

# Clipboard manager
exec --no-startup-id wl-paste --watch cliphist store

# Screen sharing support
exec --no-startup-id dbus-update-activation-environment --systemd WAYLAND_DISPLAY XDG_CURRENT_DESKTOP=sway
exec --no-startup-id systemctl --user import-environment WAYLAND_DISPLAY XDG_CURRENT_DESKTOP

# Auto-tiling script (if installed)
exec_always --no-startup-id autotiling

# ┌───────────────────────────────────────────────────────────────────────────┐
# │                        IDLE & LOCK CONFIGURATION                          │
# └───────────────────────────────────────────────────────────────────────────┘

exec swayidle -w \
    timeout 300 '$lock' \
    timeout 600 'swaymsg "output * power off"' \
        resume 'swaymsg "output * power on"' \
    timeout 900 'systemctl suspend' \
    before-sleep '$lock' \
    lock '$lock'

# ┌───────────────────────────────────────────────────────────────────────────┐
# │                          KEY BINDINGS                                     │
# └───────────────────────────────────────────────────────────────────────────┘

# ─── Core Applications ──────────────────────────────────────────────────────

bindsym --to-code $mod+Return exec $term
bindsym --to-code $mod+b      exec $browser
bindsym --to-code $mod+p      exec $menu
bindsym --to-code $mod+n      exec $fileManager

# ─── Window Management ──────────────────────────────────────────────────────

bindsym --to-code $mod+c kill
bindsym --to-code $mod+f fullscreen toggle
bindsym --to-code $mod+Shift+space floating toggle
bindsym --to-code $mod+space layout toggle split tabbed stacking
bindsym --to-code $mod+v splitv
bindsym --to-code $mod+Shift+v splith

# Floating modifier
floating_modifier $mod normal

# ─── Focus Navigation (Vim-style) ───────────────────────────────────────────

bindsym --to-code $mod+$left  focus left
bindsym --to-code $mod+$down  focus down
bindsym --to-code $mod+$up    focus up
bindsym --to-code $mod+$right focus right

# Arrow keys alternative
bindsym --to-code $mod+Left  focus left
bindsym --to-code $mod+Down  focus down
bindsym --to-code $mod+Up    focus up
bindsym --to-code $mod+Right focus right

# Focus parent/child
bindsym --to-code $mod+bracketleft  focus parent
bindsym --to-code $mod+bracketright focus child

# ─── Window Movement ────────────────────────────────────────────────────────

bindsym --to-code $mod+Shift+$left  move left
bindsym --to-code $mod+Shift+$down  move down
bindsym --to-code $mod+Shift+$up    move up
bindsym --to-code $mod+Shift+$right move right

bindsym --to-code $mod+Shift+Left  move left
bindsym --to-code $mod+Shift+Down  move down
bindsym --to-code $mod+Shift+Up    move up
bindsym --to-code $mod+Shift+Right move right

# ─── Workspaces ─────────────────────────────────────────────────────────────

# Named workspaces with icons
set $ws1  "1: "
set $ws2  "2: "
set $ws3  "3: "
set $ws4  "4: "
set $ws5  "5: "
set $ws6  "6: "
set $ws7  "7: "
set $ws8  "8: "
set $ws9  "9: "
set $ws10 "10: "

# Switch to workspace
bindsym $mod+1 workspace $ws1
bindsym $mod+2 workspace $ws2
bindsym $mod+3 workspace $ws3
bindsym $mod+4 workspace $ws4
bindsym $mod+5 workspace $ws5
bindsym $mod+6 workspace $ws6
bindsym $mod+7 workspace $ws7
bindsym $mod+8 workspace $ws8
bindsym $mod+9 workspace $ws9
bindsym $mod+0 workspace $ws10

# Move container to workspace
bindsym $mod+Shift+1 move container to workspace $ws1
bindsym $mod+Shift+2 move container to workspace $ws2
bindsym $mod+Shift+3 move container to workspace $ws3
bindsym $mod+Shift+4 move container to workspace $ws4
bindsym $mod+Shift+5 move container to workspace $ws5
bindsym $mod+Shift+6 move container to workspace $ws6
bindsym $mod+Shift+7 move container to workspace $ws7
bindsym $mod+Shift+8 move container to workspace $ws8
bindsym $mod+Shift+9 move container to workspace $ws9
bindsym $mod+Shift+0 move container to workspace $ws10

# Quick workspace navigation
bindsym --to-code $mod+Tab       workspace back_and_forth
bindsym --to-code $mod+grave     workspace next_on_output
bindsym --to-code $mod+Shift+Tab workspace prev_on_output

# ─── Scratchpad ─────────────────────────────────────────────────────────────

bindsym $mod+Shift+minus move scratchpad
bindsym $mod+minus       scratchpad show

# ─── Resize Mode ────────────────────────────────────────────────────────────

mode "󰩨 resize" {
    bindsym --to-code $left  resize shrink width  20px
    bindsym --to-code $down  resize grow   height 20px
    bindsym --to-code $up    resize shrink height 20px
    bindsym --to-code $right resize grow   width  20px

    bindsym Left  resize shrink width  20px
    bindsym Down  resize grow   height 20px
    bindsym Up    resize shrink height 20px
    bindsym Right resize grow   width  20px

    # Fine-grained resize with Shift
    bindsym --to-code Shift+$left  resize shrink width  5px
    bindsym --to-code Shift+$down  resize grow   height 5px
    bindsym --to-code Shift+$up    resize shrink height 5px
    bindsym --to-code Shift+$right resize grow   width  5px

    bindsym Return mode "default"
    bindsym Escape mode "default"
    bindsym --to-code $mod+r mode "default"
}
bindsym --to-code $mod+r mode "󰩨 resize"

# ─── Power Menu Mode ────────────────────────────────────────────────────────

set $power_mode "󰐥 [l]ock | [e]xit | [s]uspend | [r]eboot | [p]oweroff"
mode $power_mode {
    bindsym --to-code l exec $lock; mode "default"
    bindsym --to-code e exec swaymsg exit; mode "default"
    bindsym --to-code s exec systemctl suspend; mode "default"
    bindsym --to-code r exec systemctl reboot; mode "default"
    bindsym --to-code p exec systemctl poweroff; mode "default"

    bindsym Return mode "default"
    bindsym Escape mode "default"
}
bindsym --to-code $mod+Shift+e mode $power_mode

# ─── Apps Mode ──────────────────────────────────────────────────────────────

set $apps_mode "󰀻 [f]iles | [o]bsidian | [c]ode | [d]iscord | [s]potify"
mode $apps_mode {
    bindsym --to-code f exec $fileManager; mode "default"
    bindsym --to-code o exec obsidian; mode "default"
    bindsym --to-code c exec code; mode "default"
    bindsym --to-code d exec discord; mode "default"
    bindsym --to-code s exec spotify; mode "default"

    bindsym Return mode "default"
    bindsym Escape mode "default"
}
bindsym --to-code $mod+o mode $apps_mode

# ─── Tools Mode (Pomodoro, Prayer times, etc.) ──────────────────────────────

set $tools_mode "󱎫 [s]tart pomo | [k]ill pomo | [p]ause | [r]esume | [h]ijri | [e]moji"
mode $tools_mode {
    bindsym --to-code s exec ~/scripts/pomodoro.sh; mode "default"
    bindsym --to-code k exec killall pomodoro; mode "default"
    bindsym --to-code p exec killall -STOP pomodoro; mode "default"
    bindsym --to-code r exec killall -CONT pomodoro; mode "default"
    bindsym --to-code h exec /media/Maind/zahrawi/islamic/gopray-cli/gopray next | xargs -I {} notify-send "{}"; mode "default"
    bindsym --to-code e exec rofi -modi emoji -show emoji; mode "default"

    bindsym Return mode "default"
    bindsym Escape mode "default"
}
bindsym --to-code $mod+e mode $tools_mode

# ─── Custom Scripts ─────────────────────────────────────────────────────────

bindsym --to-code $mod+i exec ~/scripts/unduck-cli/unduck.sh
bindsym --to-code $mod+u exec ~/scripts/books.sh
bindsym --to-code $mod+equal exec systemctl suspend


bindsym --to-code $mod+g exec pkill -f gradle

# ─── Screenshots ────────────────────────────────────────────────────────────

# Full screen screenshot
bindsym Print exec grim ~/Pictures/Screenshots/$(date +%Y%m%d_%H%M%S).png && notify-send "Screenshot saved"

# Custom screenshot script
bindsym --to-code $mod+a exec ~/scripts/screenshot.sh

# Selection screenshot
bindsym --to-code $mod+s exec ~/scripts/sselp.sh

# Screen region to clipboard
bindsym Shift+Print exec grim -g "$(slurp)" - | wl-copy && notify-send "Screenshot copied"

# ─── Media & Hardware Keys ──────────────────────────────────────────────────

# Volume control
bindsym --locked XF86AudioMute        exec pactl set-sink-mute @DEFAULT_SINK@ toggle
bindsym --locked XF86AudioLowerVolume exec pactl set-sink-volume @DEFAULT_SINK@ -5%
bindsym --locked XF86AudioRaiseVolume exec pactl set-sink-volume @DEFAULT_SINK@ +5%
bindsym --locked XF86AudioMicMute     exec pactl set-source-mute @DEFAULT_SOURCE@ toggle

# Brightness control
bindsym --locked XF86MonBrightnessDown exec brightnessctl set 5%-
bindsym --locked XF86MonBrightnessUp   exec brightnessctl set 5%+

# Media playback
bindsym --locked XF86AudioPlay  exec playerctl play-pause
bindsym --locked XF86AudioNext  exec playerctl next
bindsym --locked XF86AudioPrev  exec playerctl previous
bindsym --locked XF86AudioStop  exec playerctl stop

# ─── Quick Actions ──────────────────────────────────────────────────────────

# Lock screen
bindsym --to-code $mod+Escape exec $lock

# Clipboard history
bindsym --to-code $mod+Shift+p exec cliphist list | rofi -dmenu -p "Clipboard" | cliphist decode | wl-copy

# Color picker
bindsym --to-code $mod+Shift+c exec grim -g "$(slurp -p)" -t ppm - | convert - -format '%[pixel:p{0,0}]' txt:- | tail -1 | cut -d' ' -f4 | wl-copy && notify-send "Color copied"

# Quick calculator
# bindsym --to-code $mod+equal exec rofi -show calc -modi calc -no-show-match -no-sort

# ─── Session Management ─────────────────────────────────────────────────────

bindsym --to-code $mod+Shift+r reload
bindsym --to-code $mod+Shift+q exec swahlynag -t warning -m 'Exit Sway?' -B 'Yes' 'swaymsg exit'

# ┌───────────────────────────────────────────────────────────────────────────┐
# │                        WINDOW RULES                                       │
# └───────────────────────────────────────────────────────────────────────────┘

# Floating windows
for_window [app_id="pavucontrol"]     floating enable
for_window [app_id="blueman-manager"] floating enable
for_window [app_id="nm-connection-editor"] floating enable
for_window [app_id="thunar" title="File Operation Progress"] floating enable
for_window [app_id="imv"]             floating enable
for_window [app_id="mpv"]             floating enable
for_window [class="Lxappearance"]     floating enable
for_window [app_id="wdisplays"]       floating enable
for_window [title="Picture-in-Picture"] floating enable, sticky enable

# Inhibit idle for fullscreen apps
for_window [app_id=".*"] inhibit_idle fullscreen
for_window [class=".*"]  inhibit_idle fullscreen

# Assign apps to workspaces
# assign [app_id="brave-browser"] $ws2
# assign [class="Brave-browser"]  $ws2
# assign [app_id="obsidian"]      $ws3
# assign [class="obsidian"]       $ws3
# assign [class="discord"]        $ws4
# assign [class="Spotify"]        $ws5

# ┌───────────────────────────────────────────────────────────────────────────┐
# │                           STATUS BAR                                      │
# └───────────────────────────────────────────────────────────────────────────┘

bar {
    swaybar_command waybar
}

# ┌───────────────────────────────────────────────────────────────────────────┐
# │                         INCLUDES                                          │
# └───────────────────────────────────────────────────────────────────────────┘

include /etc/sway/config.d/*
include ~/.config/sway/config.d/*
