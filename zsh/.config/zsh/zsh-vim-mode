#!/usr/bin/env zsh
# ╔═══════════════════════════════════════════════════════════════════════════╗
# ║                            Vi Mode for ZSH                                ║
# ╚═══════════════════════════════════════════════════════════════════════════╝

# Enable vi mode
bindkey -v

# Reduce key delay (important for vi mode responsiveness)
export KEYTIMEOUT=1

# ┌───────────────────────────────────────────────────────────────────────────┐
# │                         Cursor Shape                                      │
# └───────────────────────────────────────────────────────────────────────────┘

# Cursor shapes:
# 0 → blinking block
# 1 → blinking block (default)
# 2 → steady block
# 3 → blinking underline
# 4 → steady underline
# 5 → blinking beam
# 6 → steady beam

_cursor_block='\e[2 q'
_cursor_beam='\e[6 q'
_cursor_underline='\e[4 q'

# Change cursor based on vi mode
function zle-keymap-select() {
    case $KEYMAP in
        vicmd)         echo -ne "$_cursor_block"     ;;  # Normal mode
        viins|main)    echo -ne "$_cursor_beam"      ;;  # Insert mode
    esac
}
zle -N zle-keymap-select

# Start with beam cursor (insert mode)
function zle-line-init() {
    zle -K viins
    echo -ne "$_cursor_beam"
}
zle -N zle-line-init

# Reset cursor on command execution
function _reset_cursor() {
    echo -ne "$_cursor_beam"
}
preexec_functions+=(_reset_cursor)

# Set beam cursor on startup
echo -ne "$_cursor_beam"

# ┌───────────────────────────────────────────────────────────────────────────┐
# │                         Vi Mode Key Bindings                              │
# └───────────────────────────────────────────────────────────────────────────┘

# Fix backspace in insert mode
bindkey -v '^?' backward-delete-char
bindkey -v '^H' backward-delete-char

# Ctrl+W to delete word backward (like in normal shells)
bindkey '^W' backward-kill-word

# Ctrl+U to delete line backward
bindkey '^U' backward-kill-line

# Ctrl+A / Ctrl+E for beginning/end of line (Emacs-style)
bindkey '^A' beginning-of-line
bindkey '^E' end-of-line

# ┌───────────────────────────────────────────────────────────────────────────┐
# │                         Normal Mode Bindings                              │
# └───────────────────────────────────────────────────────────────────────────┘

# Use 'jk' or 'jj' to escape to normal mode (optional)
# bindkey -M viins 'jk' vi-cmd-mode
# bindkey -M viins 'jj' vi-cmd-mode

# Edit command in $EDITOR
autoload -Uz edit-command-line
zle -N edit-command-line
bindkey -M vicmd 'v' edit-command-line

# ┌───────────────────────────────────────────────────────────────────────────┐
# │                         Text Objects (Advanced)                           │
# └───────────────────────────────────────────────────────────────────────────┘

# Select inside/around quotes and brackets
autoload -Uz select-bracketed select-quoted
zle -N select-quoted
zle -N select-bracketed

for km in viopp visual; do
    bindkey -M $km -- '-' vi-up-line-or-history
    
    for c in {a,i}${(s..)^:-\'\"\`\|,./:;=+@}; do
        bindkey -M $km $c select-quoted
    done
    
    for c in {a,i}${(s..)^:-'()[]{}<>bB'}; do
        bindkey -M $km $c select-bracketed
    done
done

# ┌───────────────────────────────────────────────────────────────────────────┐
# │                         Surround Plugin                                   │
# └───────────────────────────────────────────────────────────────────────────┘

# Vim-like surround functionality
autoload -Uz surround
zle -N delete-surround surround
zle -N add-surround surround
zle -N change-surround surround

bindkey -M vicmd cs change-surround
bindkey -M vicmd ds delete-surround
bindkey -M vicmd ys add-surround
bindkey -M visual S add-surround

# ┌───────────────────────────────────────────────────────────────────────────┐
# │                         Menu Selection (vi-style)                         │
# └───────────────────────────────────────────────────────────────────────────┘

# Navigate completion menu with hjkl (only if menuselect keymap exists)
if zle -la | grep -q menuselect; then
    bindkey -M menuselect 'h' vi-backward-char
    bindkey -M menuselect 'j' vi-down-line-or-history
    bindkey -M menuselect 'k' vi-up-line-or-history
    bindkey -M menuselect 'l' vi-forward-char
    bindkey -M menuselect '^[[Z' reverse-menu-complete
fi

# ┌───────────────────────────────────────────────────────────────────────────┐
# │                         History Search                                    │
# └───────────────────────────────────────────────────────────────────────────┘

# Search history with current input
bindkey -M viins '^R' history-incremental-search-backward
bindkey -M vicmd '/' history-incremental-search-backward
bindkey -M vicmd '?' history-incremental-search-forward

# Ctrl+P/N for history navigation
bindkey -M viins '^P' up-line-or-history
bindkey -M viins '^N' down-line-or-history

# ┌───────────────────────────────────────────────────────────────────────────┐
# │                         Undo/Redo                                         │
# └───────────────────────────────────────────────────────────────────────────┘

bindkey -M vicmd 'u' undo
bindkey -M vicmd '^R' redo

