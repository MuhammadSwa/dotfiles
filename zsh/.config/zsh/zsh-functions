# └───────────────────────────────────────────────────────────────────────────┘

# Create directory and cd into it
function mkcd() {
    mkdir -p "$1" && cd "$1"
}

# Extract any archive
function extract() {
    if [[ -z "$1" ]]; then
        echo "Usage: extract <archive>"
        return 1
    fi
    
    if [[ ! -f "$1" ]]; then
        echo "'$1' is not a valid file"
        return 1
    fi

    case "$1" in
        *.tar.bz2)  tar xjf "$1"     ;;
        *.tar.gz)   tar xzf "$1"     ;;
        *.tar.xz)   tar xJf "$1"     ;;
        *.tar.zst)  tar --zstd -xf "$1" ;;
        *.bz2)      bunzip2 "$1"     ;;
        *.rar)      unrar x "$1"     ;;
        *.gz)       gunzip "$1"      ;;
        *.tar)      tar xf "$1"      ;;
        *.tbz2)     tar xjf "$1"     ;;
        *.tgz)      tar xzf "$1"     ;;
        *.zip)      unzip "$1"       ;;
        *.Z)        uncompress "$1"  ;;
        *.7z)       7z x "$1"        ;;
        *.xz)       unxz "$1"        ;;
        *.zst)      unzstd "$1"      ;;
        *)          echo "'$1' cannot be extracted via extract()" ;;
    esac
}

# Create a compressed archive
function compress() {
    if [[ -z "$2" ]]; then
        echo "Usage: compress <type> <file/dir>"
        echo "Types: tar.gz, tar.bz2, tar.xz, zip, 7z"
        return 1
    fi
    
    local name="${2:t}"
    case "$1" in
        tar.gz)   tar -czvf "$name.tar.gz" "$2"  ;;
        tar.bz2)  tar -cjvf "$name.tar.bz2" "$2" ;;
        tar.xz)   tar -cJvf "$name.tar.xz" "$2"  ;;
        zip)      zip -r "$name.zip" "$2"        ;;
        7z)       7z a "$name.7z" "$2"           ;;
        *)        echo "Unknown type: $1"        ;;
    esac
}

# ┌───────────────────────────────────────────────────────────────────────────┐
# │                              Git Functions                                │
# └───────────────────────────────────────────────────────────────────────────┘

# Quick git add, commit, push
function gg() {
    git add .
    if [[ -n "$1" ]]; then
        git commit -m "$*"
    else
        git commit -m "Update $(date +%Y-%m-%d\ %H:%M)"
    fi
    git push
}

# Git clone and cd into directory
function gcl() {
    git clone "$1" && cd "$(basename "$1" .git)"
}

# Interactive git branch delete
function gbd() {
    local branches=$(git branch --format='%(refname:short)' | fzf -m --preview 'git log --oneline -20 {}')
    if [[ -n "$branches" ]]; then
        echo "$branches" | xargs git branch -d
    fi
}

# Show git log with fzf
function glog() {
    git log --oneline --all | fzf --preview 'git show --color=always {1}' --bind 'enter:execute(git show {1})'
}

# ┌───────────────────────────────────────────────────────────────────────────┐
# │                            FZF Functions                                  │
# └───────────────────────────────────────────────────────────────────────────┘

# Fuzzy cd to any directory
function fcd() {
    local dir
    dir=$(fd --type d --hidden --exclude .git . "${1:-.}" | fzf --preview 'eza -T --color=always --level=2 {}' 2>/dev/null) && cd "$dir"
}

# Fuzzy find and edit file
function fe() {
    local file
    file=$(fzf --preview 'bat --color=always --style=numbers {}' 2>/dev/null) && ${EDITOR:-nvim} "$file"
}

# Fuzzy kill process
function fkill() {
    local pid
    pid=$(ps aux | sed 1d | fzf -m --preview 'echo {}' | awk '{print $2}')
    if [[ -n "$pid" ]]; then
        echo "$pid" | xargs kill -${1:-9}
    fi
}

# Fuzzy environment variable viewer
function fenv() {
    printenv | sort | fzf --preview 'echo {}' --preview-window=down:3:wrap
}

# ┌───────────────────────────────────────────────────────────────────────────┐
# │                            Docker Functions                               │
# └───────────────────────────────────────────────────────────────────────────┘

# Docker exec into container with fzf
function dsh() {
    local container
    container=$(docker ps --format '{{.Names}}' | fzf)
    if [[ -n "$container" ]]; then
        docker exec -it "$container" "${1:-/bin/sh}"
    fi
}

# Docker logs with fzf
function dlogs() {
    local container
    container=$(docker ps -a --format '{{.Names}}' | fzf)
    if [[ -n "$container" ]]; then
        docker logs -f "$container"
    fi
}

# ┌───────────────────────────────────────────────────────────────────────────┐
# │                           Development                                     │
# └───────────────────────────────────────────────────────────────────────────┘

# Run pandoc via Docker
function pandoc() {
    docker run --rm -v "$(pwd):/data" pandoc/latex "$@"
}

# OCR all PDFs in current directory
function ocrd() {
    for f in ./*.pdf; do
        [[ -f "$f" ]] && ocrmypdf "$f" "${f%.pdf}_ocr.pdf"
    done
}

# Convert file to PDF using LibreOffice
function topdf() {
    soffice --headless --convert-to pdf "$@"
}

# Go file watcher
function gowr() {
    gow -c -e=go,mod,tmpl run "${1:-.}"
}

# Create a simple HTTP server
function serve() {
    local port="${1:-8000}"
    echo "Serving on http://localhost:$port"
    python3 -m http.server "$port"
}

# JSON pretty print
function json() {
    if [[ -t 0 ]]; then
        python3 -m json.tool "$@"
    else
        python3 -m json.tool
    fi
}

# ┌───────────────────────────────────────────────────────────────────────────┐
# │                              Utilities                                    │
# └───────────────────────────────────────────────────────────────────────────┘

# Weather forecast
function wttr() {
    curl -s "wttr.in/${1:-}?format=v2"
}

# Cheat sheet
function cheat() {
    curl -s "cheat.sh/$1"
}

# Quick note
function note() {
    local note_dir="${XDG_DATA_HOME:-$HOME/.local/share}/notes"
    local note_file="$note_dir/$(date +%Y-%m-%d).md"
    
    [[ -d "$note_dir" ]] || mkdir -p "$note_dir"
    
    if [[ -n "$1" ]]; then
        echo "- $(date +%H:%M): $*" >> "$note_file"
        echo "Note added to $note_file"
    else
        ${EDITOR:-nvim} "$note_file"
    fi
}

# Pomodoro timer (requires dzen2 or similar)
function pomodoro() {
    local mins="${1:-25}"
    echo "Pomodoro: $mins minutes started"
    sleep $((mins * 60)) && notify-send "🍅 Pomodoro" "Time's up! Take a break."
}

# Backup file with timestamp
function bak() {
    cp "$1" "$1.bak.$(date +%Y%m%d_%H%M%S)"
}

# Quick calculator
function calc() {
    python3 -c "from math import *; print($*)"
}

# URL encode/decode
function urlencode() {
    python3 -c "import sys, urllib.parse; print(urllib.parse.quote(sys.argv[1]))" "$1"
}

function urldecode() {
    python3 -c "import sys, urllib.parse; print(urllib.parse.unquote(sys.argv[1]))" "$1"
}

# Show terminal colors (256 color palette)
function show-colors() {
    for i in {0..255}; do
        printf "\x1b[38;5;%sm%3d\e[0m " "$i" "$i"
        (( (i + 1) % 16 == 0 )) && echo
    done
}

# Get size of directory/file
function sizeof() {
    du -sh "${1:-.}" 2>/dev/null
}

# Find largest files in directory
function largest() {
    find "${1:-.}" -type f -exec du -h {} + 2>/dev/null | sort -rh | head -n "${2:-10}"
}

# ┌───────────────────────────────────────────────────────────────────────────┐
# │                           Plugin Management                               │
