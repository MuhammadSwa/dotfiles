#!/usr/bin/env zsh
# ╔═══════════════════════════════════════════════════════════════════════════╗
# ║                            ZSH Prompt                                     ║
# ╚═══════════════════════════════════════════════════════════════════════════╝

# Load required modules
autoload -Uz vcs_info
autoload -Uz colors && colors

# ┌───────────────────────────────────────────────────────────────────────────┐
# │                         Git Integration                                   │
# └───────────────────────────────────────────────────────────────────────────┘

# Enable only git (faster than checking all VCS)
zstyle ':vcs_info:*' enable git

# Check for changes
zstyle ':vcs_info:*' check-for-changes true

# Hook for untracked files (adds ! marker)
+vi-git-untracked() {
    if [[ $(git rev-parse --is-inside-work-tree 2>/dev/null) == 'true' ]] && \
        git status --porcelain | grep -q '??' 2>/dev/null; then
        hook_com[staged]+='!'
    fi
}

zstyle ':vcs_info:git*+set-message:*' hooks git-untracked

# Git format: (●!∂ branch) - staged=●, unstaged=∂, untracked=!
zstyle ':vcs_info:git:*' formats " %{$fg[blue]%}(%{$fg[red]%}%m%u%c%{$fg[yellow]%}%{$fg[magenta]%} %b%{$fg[blue]%})"
zstyle ':vcs_info:git:*' actionformats " %{$fg[blue]%}(%{$fg[red]%}%m%u%c%{$fg[yellow]%}%{$fg[magenta]%} %b|%a%{$fg[blue]%})"
zstyle ':vcs_info:git:*' stagedstr '●'
zstyle ':vcs_info:git:*' unstagedstr '∂'

# ┌───────────────────────────────────────────────────────────────────────────┐
# │                         Prompt Configuration                              │
# └───────────────────────────────────────────────────────────────────────────┘

# Run vcs_info before each prompt
precmd_vcs_info() { vcs_info }
precmd_functions+=(precmd_vcs_info)

# Enable prompt substitution
setopt prompt_subst

# ┌───────────────────────────────────────────────────────────────────────────┐
# │                      Original Style Prompt                                │
# │                [user@host] ➜ directory (●! branch)                        │
# └───────────────────────────────────────────────────────────────────────────┘

# Format: [user@host] ➜ directory (git info)
PROMPT="%B%{$fg[blue]%}[%{$fg[white]%}%n%{$fg[red]%}@%{$fg[white]%}%m%{$fg[blue]%}] %(?:%{$fg_bold[green]%}➜ :%{$fg_bold[red]%}➜ )%{$fg[cyan]%}%c%{$reset_color%}"
PROMPT+="\$vcs_info_msg_0_ "

